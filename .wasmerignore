# Wasmer solo necesita el runtime de Laravel y los assets compilados.
# El resto hace el paquete enorme y puede contener archivos no legibles.
node_modules/
.git/
tests/
coverage/
.phpunit.cache/
.vite/
storage/app/
storage/logs/
storage/framework/cache/data/
storage/framework/sessions/
storage/framework/views/
bootstrap/cache/*.php
