# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# Los valores activos son seguros para desarrollo. En Laravel Cloud se
# sobrescriben desde el panel (APP_KEY, DB_*, REVERB_*, APP_URL, etc.).
APP_NAME="Parchís online"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# En producción: APP_ENV=production, APP_DEBUG=false y APP_URL=https://tu-dominio.com
# APP_FORCE_HTTPS=true obliga a generar enlaces HTTPS detrás del proxy de Cloud.
APP_FORCE_HTTPS=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Local: SQLite. Producción: MySQL o PostgreSQL gestionados por Laravel Cloud.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=parchis
# DB_USERNAME=parchis
# DB_PASSWORD=
# DB_URL=

# Alternativa PostgreSQL (Cloud la inyecta automáticamente al adjuntarla):
# DB_CONNECTION=pgsql
# DB_PORT=5432

# -----------------------------------------------------------------------------
# Sesiones, caché y colas
# -----------------------------------------------------------------------------
# En Cloud, CACHE_STORE=database evita recursos extra. La cola gestionada
# establece QUEUE_CONNECTION=cloud automáticamente.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Producción: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database

# Redis/Valkey solo si se adjunta un cache dedicado (no necesario en Starter).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Correo (no se usa para jugar; se deja configurado de forma segura)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Almacenamiento (no se usan subidas; Cloud puede inyectar un bucket)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Tiempo real con Laravel Reverb
# -----------------------------------------------------------------------------
# En local, `composer run dev` levanta Reverb en 127.0.0.1:8082.
# En Laravel Cloud, al adjuntar WebSockets se inyectan REVERB_APP_ID/KEY/SECRET,
# REVERB_HOST, REVERB_PORT=443 y REVERB_SCHEME=https. No copies secretos aquí.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8082
REVERB_SCHEME=http
# Producción: REVERB_VERIFY_SSL=true
REVERB_VERIFY_SSL=false

# Solo aplica si ejecutas Reverb tú mismo (no en Cloud).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8082

# Orígenes permitidos cuando Reverb se ejecuta en este proyecto (self-host).
# En Laravel Cloud los orígenes se configuran en el panel del clúster WebSocket;
# Cloud permite automáticamente el dominio de los entornos adjuntos.
REVERB_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
# Producción: REVERB_ALLOWED_ORIGINS="https://tu-dominio.com"

REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60

# Expuestos al navegador (nunca REVERB_APP_SECRET).
VITE_APP_NAME="${APP_NAME}"
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# Alternativa: Pusher en lugar de Reverb
# -----------------------------------------------------------------------------
# 1) BROADCAST_CONNECTION=pusher y VITE_BROADCAST_CONNECTION=pusher
# 2) Rellenar estas variables con credenciales reales en el panel de Cloud.
# 3) El secreto sigue siendo solo del servidor.
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=api-mt1.pusher.com
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# VITE_PUSHER_HOST="${PUSHER_HOST}"
# VITE_PUSHER_PORT="${PUSHER_PORT}"

# -----------------------------------------------------------------------------
# Mantenimiento
# -----------------------------------------------------------------------------
# Las salas en waiting sin actividad durante este número de horas se borran.
PARCHIS_ABANDONED_ROOM_HOURS=24
