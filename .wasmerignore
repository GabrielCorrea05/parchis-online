# El runtime necesita vendor/ (autoload), los assets compilados y los
# directorios de storage con su .gitignore para que existan en el paquete.
node_modules/
public/hot
.git/
.env
tests/
coverage/
.phpunit.cache/
.vite/
storage/app/*
!storage/app/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*.php
storage/logs/*
!storage/logs/.gitignore
bootstrap/cache/*.php
